<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(SensorTfm)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SensorMonitor</RootNamespace>
    <AssemblyName>SensorMonitor</AssemblyName>
    <!-- Lets the project also build (not run) on non-Windows machines / CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SensorMonitor.Shared\SensorMonitor.Shared.csproj" />

    <!-- Build the simulator first (we don't reference its code, only need its output). -->
    <ProjectReference Include="..\SensorSimulator\SensorSimulator.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Copy the simulator's build output next to SensorMonitor.exe so the monitor can
    launch sensor processes with F5 / dotnet run, without any manual steps.
  -->
  <Target Name="CopySensorSimulator" AfterTargets="Build">
    <ItemGroup>
      <SimulatorFiles Include="..\SensorSimulator\bin\$(Configuration)\$(SensorTfm)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(SimulatorFiles)"
          DestinationFolder="$(OutDir)%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
